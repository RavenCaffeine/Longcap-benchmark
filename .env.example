# 在仓库根目录复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# score_tac.py 会自动读取当前目录（或 tac_eval/ 目录）下的 .env；也可以用 --env-file 指定。
# 已经 export 的环境变量优先，不会被 .env 覆盖。

# OpenAI 兼容接口的地址（不带 /chat/completions）
LLM_BASE_URL=https://api.deepseek.com

# API key（不要提交到 git，也不要发给别人）
LLM_API_KEY=

# 模型名。论文用的是 DeepSeek-V4-Flash（开启 thinking），填你的服务商给出的模型 id
LLM_MODEL=

# 可选：合并进每个请求 body 的额外 JSON，例如开启 thinking 的参数（按服务商文档填写）
# LLM_EXTRA={}
